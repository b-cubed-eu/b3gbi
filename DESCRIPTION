Type: Package
Package: b3gbi
Title: General Biodiversity Indicators for Biodiversity Data Cubes
Version: 1.0.0.9005
Authors@R: c(
    person("Shawn", "Dove", email = "Shawn.Dove@allzool.bio.uni-giessen.de",
